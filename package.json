{
  "name": "playwright-tradesource",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "Jonathan R",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:headed": "bddgen && playwright test --headed",
    "test:debug": "bddgen && playwright test --debug",
    "test:ui": "bddgen && playwright test --ui",
    "test:spec": "bddgen && playwright test",
    "test:chromium": "bddgen && playwright test --project=chromium --project=bdd-chromium",
    "test:firefox": "bddgen && playwright test --project=firefox",
    "test:webkit": "bddgen && playwright test --project=webkit",
    "test:update-snapshots": "bddgen && playwright test --update-snapshots",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:4321"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "axe-html-reporter": "^2.2.11",
    "playwright-bdd": "^9.2.1",
    "typescript": "^7.0.2"
  }
}
