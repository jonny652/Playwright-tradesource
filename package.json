{
  "name": "playwright-tradesource",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "Jonathan R",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:spec": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:visual": "playwright test tests/visual-regression.spec.ts",
    "test:visual:generate-baselines": "playwright test tests/visual-regression.spec.ts --update-snapshots",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:4321"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "axe-html-reporter": "^2.2.11",
    "typescript": "^7.0.2"
  }
}
