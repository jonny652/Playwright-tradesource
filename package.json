{
  "name": "playwright-tradesource",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "Jonathan R",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --project=setup --project=chromium --project=firefox --project=webkit",
    "test:headed": "playwright test --headed --project=setup --project=chromium --project=firefox --project=webkit",
    "test:debug": "playwright test --debug --project=setup --project=chromium --project=firefox --project=webkit",
    "test:ui": "playwright test --ui --project=setup --project=chromium --project=firefox --project=webkit",
    "test:spec": "playwright test --project=setup --project=chromium --project=firefox --project=webkit",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:visual": "playwright test --project=visual-desktop-1280x720",
    "test:visual:docker": "docker compose -f docker-compose.visual.yml run --rm visual",
    "test:visual:update": "docker compose -f docker-compose.visual.yml run --rm visual-update",
    "visual:manifest": "node scripts/visual-manifest.mjs",
    "visual:gallery": "node scripts/visual-gallery.mjs",
    "visual:orphans": "node scripts/visual-orphans.mjs",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:4321"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "axe-html-reporter": "^2.2.11",
    "typescript": "^7.0.2"
  }
}
